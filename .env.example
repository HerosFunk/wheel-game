# MongoDB Configuration (externe - déjà existant)
# Remplacer par votre URI MongoDB réel
# Format: mongodb://username:password@host:port/database?authSource=admin
# Exemple: mongodb://admin:password123@localhost:27017/wheel-game?authSource=admin
MONGODB_URI=mongodb://your_username:your_password@your_mongodb_host:27017/wheel-game?authSource=admin

# Backend Configuration
JWT_SECRET=your_jwt_secret_key
NODE_ENV=development

# API URLs (change for production)
REACT_APP_API_URL=http://localhost:3000

# Ports
BACKEND_PORT=3000
FRONTEND_PORT=3001
MONGODB_PORT=27017
