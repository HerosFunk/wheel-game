# MongoDB Configuration (container externe existant sur le VPS)
# host.docker.internal permet d'accéder au mongo qui tourne sur l'hôte
MONGODB_URI=mongodb://admin:password123@host.docker.internal:27017/wheel-game?authSource=admin

# Backend Configuration
JWT_SECRET=change_me_to_a_random_secret
NODE_ENV=production

# Authentication passwords
PASSWORD_CREATOR=your_creator_password
PASSWORD_CLIENT=your_client_password

# CORS - set to your domain in production (e.g. https://yourdomain.com)
FRONTEND_URL=*

# Ports
BACKEND_PORT=3000
FRONTEND_PORT=80
